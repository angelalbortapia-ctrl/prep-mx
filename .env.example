# URL pública (sitemap, emails, OG)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Variables NEXT_PUBLIC_* → disponibles en el navegador ('use client').
# Secrets (CLERK_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY, etc.)
# solo en servidor / API routes. Si falta NEXT_PUBLIC_ en cliente, Vercel build = undefined.

# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# URI directa para pg_dump (Settings → Database → Connection string, puerto 5432)
# Solo servidor / CI — nunca NEXT_PUBLIC_
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres

# Modo demo — bypass de login en /dashboard (solo dev o con true explícito)
# NEXT_PUBLIC_DEMO_MODE=true

# Kill switch — bloquea dashboard, simulador y APIs (excepto webhooks/health/inngest)
# NEXT_PUBLIC_MAINTENANCE_MODE=true
# NEXT_PUBLIC_MAINTENANCE_ETA=30 minutos
# NEXT_PUBLIC_MAINTENANCE_MESSAGE=Estamos actualizando el banco de reactivos.

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhook en /api/webhooks/clerk (eventos user.created, user.updated)
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Stripe — webhook en /api/webhooks/stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs (Dashboard → Productos → Precio → API ID)
STRIPE_PRICE_PRO_UNAM=
STRIPE_PRICE_PRO_IPN=
STRIPE_PRICE_PRO_UAM=
STRIPE_PRICE_TODOS=
# Checkout metadata: clerk_id + userId (Clerk) + premium_scope = unam|ipn|uam|todos

# Inngest — jobs async (Early Bird, SM-2 emails)
# INNGEST_EVENT_KEY=  # producción
# INNGEST_SIGNING_KEY=  # producción

# Resend — correos transaccionales
RESEND_API_KEY=
RESEND_FROM_EMAIL=PrepMX <onboarding@tudominio.com>

# OpenAI / IA — Paso 2
OPENAI_API_KEY=

# Bunny.net — CDN de imágenes/PDFs + Stream para videos explicativos
# Pull Zone hostname (sin https), ej. prepmx.b-cdn.net
NEXT_PUBLIC_BUNNY_CDN_HOSTNAME=
# Bunny Stream → Video Library ID (panel Stream)
NEXT_PUBLIC_BUNNY_STREAM_LIBRARY_ID=
# Token Authentication del Pull Zone (solo servidor; no NEXT_PUBLIC)
BUNNY_CDN_TOKEN_KEY=

# Sentry — observabilidad / alertas de errores 5xx en producción
# Crea proyecto en https://sentry.io → Alerts → email o Discord webhook
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=  # alternativa solo servidor
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=  # opcional: subir source maps en build (CI/Vercel)
# SENTRY_ENVIRONMENT=production

# PostHog — analítica de producto (pageviews + funnels del dashboard)
# Proyecto en https://posthog.com → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Conversión de pago — Meta Ads + Google Ads (Buen Fin / campañas)
# Meta: Events Manager → Pixel ID (solo números)
NEXT_PUBLIC_META_PIXEL_ID=
# GA4: Admin → Data Streams → Measurement ID (G-XXXXXXXX)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
